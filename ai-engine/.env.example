# AI Engine environment (Python / FastAPI)
# Copy to .env and adjust. Never commit real secrets or API keys.

AI_ENGINE_PORT=8000

# Comma-separated list of allowed CORS origins (frontend + backend)
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# AI provider (Phase 4+). Keep "mock" for now. No real keys yet.
# Supported (future): anthropic | openai | local | mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
