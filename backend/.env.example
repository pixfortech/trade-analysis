# Backend environment (Node.js / Express)
# Copy to .env and adjust. Never commit real secrets.

BACKEND_PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the frontend).
# In development the backend ALSO auto-allows GitHub Codespaces origins
# (*.app.github.dev); that wildcard is disabled when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# URL of the Python AI engine the backend calls (analysis routes proxy to it)
AI_ENGINE_URL=http://localhost:8000
# How long (ms) to wait for the AI engine before falling back to mock data
AI_ENGINE_TIMEOUT_MS=4000

# Market data provider (Phase 3+). Keep as "mock" for now. No real keys yet.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Zerodha Kite Connect — Phase 3A (READ-ONLY live market data)
# ---------------------------------------------------------------------------
# SECURITY: KITE_API_SECRET and KITE_ACCESS_TOKEN are SERVER-SIDE ONLY.
# Never expose them to the frontend and never commit a real .env.
# Get credentials from your own Kite developer account: https://developers.kite.trade/
#
# Master switch. When false, the backend returns a clear "disabled" message
# and makes NO calls to Kite. Leave false until you have real credentials.
KITE_ENABLE_LIVE_DATA=false
# Public — appears in the login URL (safe to send to the browser).
KITE_API_KEY=
# Secret — used only to sign the login checksum, server-side. NEVER expose.
KITE_API_SECRET=
# Optional pre-obtained access token (otherwise use the login flow).
KITE_ACCESS_TOKEN=
# Redirect URL registered in your Kite app (e.g. http://localhost:4000/api/kite/callback).
KITE_REDIRECT_URL=http://localhost:4000/api/kite/callback
