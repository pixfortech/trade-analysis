# Backend environment (Node.js / Express)
# Copy to .env and adjust. Never commit real secrets.

BACKEND_PORT=4000
NODE_ENV=development

# Comma-separated list of EXTRA allowed CORS origins (optional).
# The backend ALWAYS allows the deployed Firebase frontend
# (*.web.app / *.firebaseapp.com) and localhost:3000/4000 — even in production —
# so you normally do NOT need to set this. In development it also auto-allows
# GitHub Codespaces origins (*.app.github.dev). Use this only to add more.
# Example: CORS_ORIGIN=https://app.example.com,https://staging.example.com
CORS_ORIGIN=http://localhost:3000

# URL of the Python AI engine the backend calls (analysis routes proxy to it)
AI_ENGINE_URL=http://localhost:8000
# How long (ms) to wait for the AI engine before falling back to mock data
AI_ENGINE_TIMEOUT_MS=4000

# Public URL of the deployed frontend/dashboard. After a successful Kite login,
# the callback redirects the login tab to <FRONTEND_URL>/kite/connected so it
# lands on the SAME origin as the dashboard (enabling auto-close + auto-update).
# Leave blank to use a safe default: http://localhost:3000 in development, and
# the deployed Firebase site in production. Set this if your frontend lives
# elsewhere. Example: FRONTEND_URL=https://your-site.web.app
FRONTEND_URL=

# Market data provider (Phase 3+). Keep as "mock" for now. No real keys yet.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Zerodha Kite Connect — Phase 3A (READ-ONLY live market data)
# ---------------------------------------------------------------------------
# SECURITY: KITE_API_SECRET and KITE_ACCESS_TOKEN are SERVER-SIDE ONLY.
# Never expose them to the frontend and never commit a real .env.
# Get credentials from your own Kite developer account: https://developers.kite.trade/
#
# Master switch. When false, the backend returns a clear "disabled" message
# and makes NO calls to Kite. Leave false until you have real credentials.
KITE_ENABLE_LIVE_DATA=false
# Public — appears in the login URL (safe to send to the browser).
KITE_API_KEY=
# Secret — used only to sign the login checksum, server-side. NEVER expose.
KITE_API_SECRET=
# Optional pre-obtained access token (otherwise use the login flow).
KITE_ACCESS_TOKEN=
# Redirect URL registered in your Kite app (e.g. http://localhost:4000/api/kite/callback).
KITE_REDIRECT_URL=http://localhost:4000/api/kite/callback

# ===========================================================================
# Real-time intelligence config (src/config/intelligence.config.ts)
# ---------------------------------------------------------------------------
# EVERY value below is OPTIONAL — leave blank/unset to use the safe, documented
# defaults baked into intelligence.config.ts. Set any of them to override at
# runtime without a code change. Invalid values fall back to the default with a
# startup warning (numbers are range-clamped; bad URLs are ignored). NONE of the
# secrets here are exposed by GET /api/config/public.

# --- News ingestion (server-side RSS; no key needed for the default provider) -
# Provider mode: rss | newsapi | disabled
NEWS_PROVIDER=rss
# Comma-separated RSS feed URLs (PRIVATE — never sent to the browser).
# Default: Moneycontrol + Business Standard + Economic Times market feeds.
NEWS_RSS_URLS=
# Only used when NEWS_PROVIDER=newsapi (server-side only):
NEWS_API_KEY=
NEWS_MAX_ITEMS=30
NEWS_PER_FEED_CAP=40
NEWS_CACHE_MINUTES=5
NEWS_DECAY_HOURS=12
NEWS_STALE_HOURS=48
NEWS_FETCH_TIMEOUT_MS=6000
# Comma-separated sentiment lexicons (override the built-in word lists):
NEWS_POSITIVE_WORDS=
NEWS_NEGATIVE_WORDS=
NEWS_HIGH_IMPACT_WORDS=
# Instrument-relevance gate: a headline must score >= minDecisionScore
# (DIRECT_INSTRUMENT/UNDERLYING/SECTOR) to affect the decision; the
# minDisplayScore..minDecisionScore band is context-only; below minDisplayScore
# it is dropped. minDirectScore is the "directly relevant" cutoff (count).
NEWS_MIN_DECISION_RELEVANCE=55
NEWS_MIN_DISPLAY_RELEVANCE=25
NEWS_MIN_DIRECT_RELEVANCE=80
# Per relevance-type scores (0–100):
NEWS_RELEVANCE_DIRECT_SCORE=95
NEWS_RELEVANCE_UNDERLYING_SCORE=85
NEWS_RELEVANCE_SECTOR_SCORE=60
NEWS_RELEVANCE_BENCHMARK_SCORE=40
NEWS_RELEVANCE_MACRO_SCORE=32
NEWS_RELEVANCE_MARKET_SCORE=28
NEWS_RELEVANCE_IRRELEVANT_SCORE=0
# Tie/order priorities for ranking relevant headlines (higher = first):
NEWS_PRIORITY_DIRECT=6
NEWS_PRIORITY_UNDERLYING=5
NEWS_PRIORITY_SECTOR=4
NEWS_PRIORITY_BENCHMARK=3
NEWS_PRIORITY_MARKET_WIDE=2
NEWS_PRIORITY_MACRO=2
NEWS_PRIORITY_IRRELEVANT=0

# Instrument taxonomy override (indices / stock→sector mappings / aliases /
# related entities / benchmark aliases / market-wide terms). JSON merged over
# the built-in defaults in src/config/instrumentTaxonomy.config.ts. Leave blank
# to use defaults. Shape: {"indices":[...],"sectors":{"SYM":{...}},
# "benchmarkAliases":{"NIFTY":[...]},"marketWideTerms":[...]}.
INSTRUMENT_TAXONOMY_JSON=

# --- India VIX (volatility) ---------------------------------------------------
# Comma-separated candidate symbols; the first quotable one is used.
VIX_SYMBOLS=
VIX_LOW_THRESHOLD=13
VIX_NORMAL_THRESHOLD=17
VIX_HIGH_THRESHOLD=22
VIX_DIRECTION_SENSITIVITY_PCT=1.5
VIX_CACHE_MS=30000

# --- Decision engine (weights are normalised to sum 1; win gate preserved) ----
INTEL_TECHNICAL_WEIGHT=0.45
INTEL_NEWS_WEIGHT=0.2
INTEL_BREADTH_WEIGHT=0.2
INTEL_VOLUME_WEIGHT=0.15
# Approval gates: ENTER requires win-estimate AND confidence at/above these.
INTEL_WIN_ESTIMATE_THRESHOLD=75
INTEL_MIN_ENTER_CONFIDENCE=75

# --- Top movers (bounded scan to respect Kite rate limits) --------------------
# Comma-separated tradingsymbols for the equity scan universe.
MOVERS_EQUITY_UNIVERSE=
MOVERS_EQUITY_EXCHANGE=NSE
MOVERS_SCAN_LIMIT=40
MOVERS_BREADTH_CACHE_MS=60000

# --- Kite token verification probe --------------------------------------------
KITE_TOKEN_VERIFY_SYMBOL=NSE:INFY
KITE_TOKEN_VERIFY_CACHE_MS=20000

# --- Refresh intervals (ms) — also served to the client via /api/config/public -
LIVE_SIGNAL_REFRESH_MS=5000
WATCHLIST_REFRESH_MS=12000
INTELLIGENCE_REFRESH_MS=45000
TOP_STRIP_REFRESH_MS=10000
VIX_REFRESH_MS=60000
KITE_STATUS_REFRESH_MS=20000

# --- Default instruments / indicators (client defaults via /api/config/public) -
# "EXCH:SYM|Display,EXCH:SYM|Display" for the two symbol lists:
TOP_STRIP_DEFAULT_SYMBOLS=
WATCHLIST_DEFAULT_SYMBOLS=
BENCHMARK_SYMBOLS=
# Comma-separated indicator IDs requested by the client (e.g. VWAP,EMA20,RSI):
DEFAULT_ACTIVE_INDICATORS=

# ===========================================================================
# Real-time DECISION LOOP (src/config/intelligence.config.ts → loop). Every
# value is OPTIONAL — blank uses the documented default. No magic numbers live
# in the loop/detector services.
# --- Data-quality gate (never presents stale as fresh) ---
LOOP_QUOTE_STALE_SEC=90
LOOP_CANDLE_STALE_INTERVALS=3
LOOP_MIN_CANDLES=30
LOOP_WARMUP_CANDLES=50
# --- Market-regime classification ---
LOOP_REGIME_ADX_TREND_MIN=20
LOOP_REGIME_ADX_STRONG_MIN=32
LOOP_REGIME_ATR_EXPANSION_PCT=25
# --- Connors RSI mean-reversion setup ---
LOOP_CRSI_RSI_PERIOD=3
LOOP_CRSI_STREAK_PERIOD=2
LOOP_CRSI_RANK_PERIOD=100
LOOP_CRSI_OVERSOLD=15
LOOP_CRSI_OVERBOUGHT=85
LOOP_CRSI_TREND_EMA=50
LOOP_CRSI_CONFIRM_CANDLES=1
# --- Chandelier Exit (trailing / exit management, not entry) ---
LOOP_CE_ATR_PERIOD=22
LOOP_CE_ATR_MULT=3
LOOP_CE_USE_CLOSE=true
# --- Range Filter + HACOLT (secondary confirmation) ---
LOOP_RF_PERIOD=20
LOOP_RF_MULT=3
LOOP_HACOLT_EMA_PERIOD=55
# --- Breakout / breakdown ---
LOOP_BREAKOUT_LOOKBACK=20
LOOP_BREAKOUT_VOL_MULT=1.2
LOOP_BREAKOUT_ATR_BUFFER=0.25
# --- Trade-quality gates ---
LOOP_SAFE_ZONE_ATR_MULT=0.6
LOOP_RR_MIN=1.5
# --- Anti-flicker / hysteresis ---
LOOP_MIN_CONFIRMATIONS=2
LOOP_ENTER_CONFIRMATIONS=2
LOOP_COOLDOWN_MS=120000
LOOP_MIN_STATE_DURATION_MS=15000
LOOP_MAX_HISTORY=40
# --- Fresh-setup auto-lock (false = require explicit Lock New Plan) + backtest ---
LOOP_AUTO_LOCK=false
LOOP_BACKTEST_MIN_SAMPLE=30
