# ==========================================================
# AI Share Market Analysis Tool - Environment Variables (EXAMPLE)
# ==========================================================
# HOW TO USE:
#   1. Copy this file:            cp .env.example .env
#   2. Fill in real values        (locally only)
#   3. NEVER commit a real .env or any real secret/API key.
#
# Each sub-project (frontend / backend / ai-engine) also ships
# its own .env.example. This root file is the master reference.
# ----------------------------------------------------------

# ----------------------------------------------------------
# Frontend (Next.js)
# ----------------------------------------------------------
# Public values are exposed to the browser (must be prefixed NEXT_PUBLIC_).
# Leave NEXT_PUBLIC_BACKEND_URL BLANK to use the smart default: auto-detect the
# GitHub Codespaces backend URL in the browser, or http://localhost:4000 locally.
# Set it only to force a specific backend URL (restart the dev server after).
# The frontend calls the BACKEND only; the AI engine is reached backend-side.
NEXT_PUBLIC_BACKEND_URL=

# ----------------------------------------------------------
# Backend (Node.js / Express)
# ----------------------------------------------------------
BACKEND_PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000
# URL the backend uses to reach the Python AI engine
AI_ENGINE_URL=http://localhost:8000
# How long (ms) the backend waits for the AI engine before mock fallback
AI_ENGINE_TIMEOUT_MS=4000

# ----------------------------------------------------------
# AI Engine (Python / FastAPI)
# ----------------------------------------------------------
AI_ENGINE_PORT=8000

# ----------------------------------------------------------
# Market Data Provider  (Phase 3+ - DO NOT add real keys yet)
# ----------------------------------------------------------
# Supported (future): zerodha | upstox | dhan | angelone | truedata | mock
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_ACCESS_TOKEN=

# ----------------------------------------------------------
# AI Provider  (Phase 4+ - DO NOT add real keys yet)
# ----------------------------------------------------------
# Supported (future): anthropic | openai | local | mock
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
