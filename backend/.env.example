# Backend environment (Node.js / Express)
# Copy to .env and adjust. Never commit real secrets.

BACKEND_PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (the frontend).
# In development the backend ALSO auto-allows GitHub Codespaces origins
# (*.app.github.dev); that wildcard is disabled when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000

# URL of the Python AI engine the backend calls (analysis routes proxy to it)
AI_ENGINE_URL=http://localhost:8000
# How long (ms) to wait for the AI engine before falling back to mock data
AI_ENGINE_TIMEOUT_MS=4000

# Market data provider (Phase 3+). Keep as "mock" for now. No real keys yet.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_ACCESS_TOKEN=
