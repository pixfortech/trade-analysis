# ==========================================================
# AI Share Market Analysis Tool - .gitignore
# ==========================================================

# ---------- Dependencies ----------
node_modules/
**/node_modules/
.pnp/
.pnp.js

# ---------- Next.js / Frontend builds ----------
.next/
out/

# ---------- Generic build output ----------
dist/
build/
*.tsbuildinfo
next-env.d.ts

# ---------- Environment variables (NEVER commit secrets) ----------
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ---------- Python / AI engine ----------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Testing / Coverage ----------
coverage/
.nyc_output/

# ---------- OS / Editor ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ---------- Misc ----------
.cache/
tmp/
temp/
